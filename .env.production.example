# Hosting panelindeki Environment bölümüne ekleyin. Gerçek şifreleri Git'e koymayın.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=10000
ASPNETCORE_HTTPS_PORT=443
# Yalnız Render ağ geçidi arkasında true; doğrudan internete açık sunucuda kapalı kalmalı.
ReverseProxy__Enabled=true
Features__EnableSampleControllers=false
Database__MigrateOnStartup=true
JWT_SECRET=
# Neon'daki doğrudan DATABASE_URL değerini tırnak ve DATABASE_URL= öneki olmadan ekleyin.
# postgresql://... biçimi ve CONNECTION_STRING içindeki Npgsql biçimi desteklenir.
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=meteoroloji
DB_USERNAME=
DB_PASSWORD=
Cors__AllowedOrigins__0=https://site-adiniz.vercel.app
Mail__Enabled=false
# SMTP ve günlük mail etkinleştirilecekse, sunucu uyumamalı ve SMTP portuna erişebilmelidir.
Mail__DeliveryMode=Smtp
Mail__Host=
Mail__Port=587
Mail__Username=
Mail__Password=
Mail__FromAddress=
Mail__FromName=Meteoroloji
Mail__FrontendUrl=https://site-adiniz.vercel.app
Mail__ApiUrl=https://site-adiniz.vercel.app
# Yönetici hesabı: bu adrese mail koduyla giriş yapan kişi /admin paneline erişebilir.
WeatherAdmin__Emails__0=
